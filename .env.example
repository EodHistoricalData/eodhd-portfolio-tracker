# Required. Get one at https://eodhd.com/register?utm_source=eodhd_oss&utm_medium=app&utm_campaign=portfolio-tracker&utm_content=env
# A free key is enough for your own positions: each is priced from a live
# quote, one request, so the free plan's twenty requests a day are the limit
# you will meet first. Fund templates read fundamentals, which need All-In-One
# or the Fundamentals Data Feed.
# It stays on this machine and is never sent to the browser.
EODHD_API_KEY=your_api_key_here

# Optional. Enables the AI analysis buttons. Without it every other part of the
# app works and the AI affordances simply do not appear.
# OPENAI_API_KEY=

# Optional. Any OpenAI-compatible endpoint works — Groq, DeepSeek, OpenRouter,
# or a local Ollama at http://localhost:11434/v1.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional. The local port, if 5173 is taken (Vite's default is the same one).
# PORT=5173
